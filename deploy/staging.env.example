# Modèle de /etc/eba/staging.env (lu par `docker run --env-file`).
# ATTENTION au format Docker : une ligne KEY=valeur, SANS guillemets (ils seraient gardés).
# Chmod 600, propriétaire = l'utilisateur de déploiement. Ne jamais committer le vrai fichier.

APP_ENV=staging
TZ=UTC

# Le nom de la base DOIT contenir « staging » (sinon le conteneur refuse de démarrer).
DATABASE_URL=postgresql://eba_staging:CHANGE_ME@host.docker.internal:5432/eba_staging
NEXT_PUBLIC_SITE_URL=https://staging.eba-coffee.com
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
# Facultatif (voir docs/deploiement.md) : clé fixe des server actions.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Réchauffage du déploiement. En staging aucun cron n'est planifié : le secret ne sert qu'à ça.
CRON_SECRET=CHANGE_ME_openssl_rand_hex_24

# E-mails : aucun envoi en staging (APP_ENV=staging), mais le schéma exige ces champs.
RESEND_API_KEY=re_staging_unused
RESEND_FROM=EBA Staging <staging@staging.invalid>
OWNER_EMAIL=owner@staging.invalid
ADMIN_EMAIL=admin@staging.invalid

# Cloudinary : même compte, dossier séparé.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=CHANGE_ME
NEXT_PUBLIC_CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_FOLDER_PREFIX=eba-staging
NEXT_PUBLIC_WAVE_MERCHANT_ID=CHANGE_ME

# Paiement Jèko : serveur factice (scripts/jeko-mock) sur l'hôte, jamais l'API réelle.
JEKO_API_BASE_URL=http://host.docker.internal:4010
JEKO_API_KEY=staging-mock-api-key
JEKO_API_KEY_ID=staging-mock-key-id
JEKO_STORE_ID=staging-mock-store
JEKO_WEBHOOK_SECRET=staging-mock-webhook-secret

# Laisser VIDES / absents en staging : VAPID_*, OPENROUTER_API_KEY, NEXT_PUBLIC_GTM_ID,
# NEXT_PUBLIC_META_PIXEL_ID, SENTRY_DSN, NEXT_PUBLIC_SENTRY_DSN, JEKO_B_*.
