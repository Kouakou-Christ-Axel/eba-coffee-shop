# .env.example — à copier en `.env` pour le développement local (`pnpm dev`).
#
# La référence est `.env.schema` (varlock) : il décrit chaque variable, son type
# et si elle est obligatoire. Ce fichier ne contient que des valeurs d'exemple ou
# de développement, jamais de vrais secrets. Les variables obligatoires ont ici
# une valeur factice pour que l'application démarre ; remplace-les au besoin.
#
# Paiement en ligne (Jèko) en local : voir `docs/paiement-en-ligne.md`.

# ── Base de données ──────────────────────────────────────────────────────────
# PostgreSQL du docker-compose (`docker compose up -d`), exposé sur le port 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/eba_coffee_shop

# ── Site ─────────────────────────────────────────────────────────────────────
# Racine publique (un slash final est toléré). En local : http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Authentification (Better Auth) ───────────────────────────────────────────
# Générer une vraie valeur : `openssl rand -hex 32`
BETTER_AUTH_SECRET=dev-secret-a-remplacer-par-openssl-rand-hex-32
BETTER_AUTH_URL=${NEXT_PUBLIC_SITE_URL}

# ── E-mails (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_dev_placeholder
RESEND_FROM="EBA Coffee Shop <onboarding@resend.dev>"
# Reçoit les notifications de nouvelles commandes.
OWNER_EMAIL=proprietaire@example.com
# Compte administrateur créé par `pnpm db:seed`.
ADMIN_EMAIL=admin@example.com

# ── Images (Cloudinary) ──────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=demo
NEXT_PUBLIC_CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=dev-placeholder
# CLOUDINARY_FOLDER_PREFIX=dev

# ── Paiement en ligne (Jèko) ─────────────────────────────────────────────────
# Tant que ces quatre variables ne sont pas toutes renseignées, le paiement en ligne
# reste INERTE : les commandes se règlent au comptoir (plus de capture d'écran).
#
# ⚠️  Les valeurs ci-dessous sont celles du serveur Jèko FACTICE (`pnpm jeko:mock`).
# Elles sont commentées exprès : ne jamais les copier en production. En production,
# les vraies valeurs viennent de https://business.jeko.africa/ (Paramètres >
# API & Webhooks) — voir `docs/paiement-en-ligne.md`.
#
# Pour tester en local, décommenter ce bloc :
# JEKO_API_KEY=local-key
# JEKO_API_KEY_ID=local-key-id
# JEKO_STORE_ID=00000000-0000-4000-8000-000000000001
# JEKO_WEBHOOK_SECRET=whsec_local_dev
# Pointe l'application vers le serveur factice (absente = vrai Jèko).
# JEKO_API_BASE_URL=http://127.0.0.1:4010
# Frais facturés au client, en % du total (absente = 1).
# ONLINE_FEE_PERCENT=1
# Réglages du serveur factice lui-même (facultatifs) :
# JEKO_MOCK_PORT=4010
# JEKO_MOCK_WEBHOOK_URL=http://localhost:3000/api/webhooks/jeko

# ── Facultatif ───────────────────────────────────────────────────────────────
# Serveur MCP (clé « machine » pour curl/CLI ; OAuth reste actif sans elle).
# MCP_API_KEY=
# Déclencheur externe du rappel d'inventaire (inerte si absent).
# CRON_SECRET=
# Notifications push du dashboard (`pnpm exec web-push generate-vapid-keys`).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:proprietaire@example.com
# Analytics (inertes sans consentement).
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_META_PIXEL_ID=

# ── Wave (récapitulatif WhatsApp envoyé par le staff) ───────────────────────
# Identifiant marchand Wave : sert au lien de paiement du message de récap que la
# caisse envoie par WhatsApp. Sans rapport avec le paiement en ligne Jèko.
NEXT_PUBLIC_WAVE_MERCHANT_ID=dev
